# ============================================================
#  ShopO-AI — environment configuration
#  Copy this file to .env (in the project root) and fill it in.
#  Only MONGO_URI and JWT_SECRET are required; everything else
#  enables an optional feature and has a working fallback.
# ============================================================

# ---------- Required ----------
# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/shopo-ai
# Long random string used to sign login tokens (change this!)
JWT_SECRET=change_me_to_a_long_random_string_please

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Allowed frontend origins (comma separated). Also used for links in emails.
CLIENT_URL=http://localhost:3000
# Emails that become admins on registration (can register QR codes)
ADMIN_EMAILS=

# ---------- Price alerts: email (Nodemailer / SMTP) ----------
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 and an App Password
# If left empty, alert emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShopO-AI <no-reply@shopo-ai.app>"

# ---------- Price alerts: SMS (Twilio, optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# How often the price monitor runs (cron syntax). Default: every 30 minutes
PRICE_CHECK_CRON=*/30 * * * *

# ---------- AI / cloud APIs (optional) ----------
# Google Cloud Vision — better image search (falls back to local MobileNet)
GOOGLE_VISION_API_KEY=
# Google Speech-to-Text — voice search in browsers without Web Speech API
# (Chrome/Edge/Safari use the built-in browser speech recognition)
GOOGLE_STT_API_KEY=
# Hugging Face — DistilBERT review sentiment (falls back to AFINN lexicon)
HF_API_KEY=

# ---------- Tuning ----------
# Requests per 15 min per IP / searches per minute per IP
API_RATE_LIMIT=300
SEARCH_RATE_LIMIT=10
# A QR code scanned by more than this many accounts is flagged as cloned
QR_CLONE_THRESHOLD=5
